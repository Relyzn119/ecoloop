        "jsCode": "const reservations = $input.all();\nreturn reservations.map((item, index) => {\n  const response = item.json;\n  const statusCode = Number(response.statusCode ?? response.status) || null;\n  const body = response.body ?? {};\n  const reservationOk = statusCode !== null && statusCode >= 200 && statusCode < 300 && !response.error && body.success !== false && String(body.status ?? '').toLowerCase() !== 'error';\n  const decision = $('Route AI Decision').itemMatching(index).json;\n  const partnerId = decision.recommended_partner_id || 1;\n  const productName = decision.product_name ?? 'food item';\n  const quantity = decision.quantity ?? 'unspecified';\n  const reason = decision.reasoning ?? 'No reason provided';\n  return { json: {\n    product_id: decision.product_id,\n    product_name: productName,\n    quantity,\n    partner_id: partnerId,\n    action: 'donate',\n    reasoning: reason,\n    reservation_ok: reservationOk,\n    reservation_http_status: statusCode,\n    reservation_error: reservationOk ? null : response.error?.message ?? body.message ?? 'Donation reservation did not return a successful response.',\n    reservation_api_message: body.message ?? null,\n    message: `Urgent Food Rescue Alert: ${quantity} units of ${productName} are reserved for donation. Reason: ${reason}`,\n  } };\n});",
