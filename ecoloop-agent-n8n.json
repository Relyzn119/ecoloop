      "parameters": {
        "jsCode": "const responses = $input.all();\nreturn responses.map((item, index) => {\n  const response = item.json;\n  const decision = $('Route AI Decision').itemMatching(index).json;\n  const statusCode = Number(response.statusCode ?? response.status) || null;\n  const body = response.body ?? {};\n  const success = statusCode === 200 && !response.error && body.success !== false && String(body.status ?? '').toLowerCase() !== 'error';\n  return { json: {\n    event: success ? 'ecoloop_discount_applied' : 'ecoloop_discount_failed',\n    success,\n    action: 'discount',\n    processing_status: success ? 'success' : 'failed',\n    http_status: statusCode,\n    product_id: decision.product_id,\n    discount_percentage: decision.discount_percentage,\n    reason: decision.reasoning,\n    api_message: body.message ?? null,\n    error: success ? null : response.error?.message ?? body.message ?? 'Discount callback did not return HTTP 200.',\n    logged_at: new Date().toISOString(),\n  } };\n});",
