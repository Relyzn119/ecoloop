        "jsCode": "const response = $input.first().json;\nconst decision = $('Route Live Demo Decision').item.json;\nconst isNoAction = decision.action === 'none';\nconst status = Number(response.statusCode ?? response.status) || null;\nconst body = response.body ?? {};\nconst apiOk = isNoAction || (status !== null && status >= 200 && status < 300 && !response.error && body.success !== false && String(body.status ?? '').toLowerCase() !== 'error');\nreturn [{json:{success:apiOk, product_id:decision.product_id, action_taken:decision.action, reasoning:decision.reasoning, timestamp:new Date().toISOString(), total_processed:1, total_discounted:decision.action === 'discount' ? 1 : 0, total_donated:decision.action === 'donate' ? 1 : 0, total_skipped:decision.action === 'none' ? 1 : 0, status:apiOk ? 'success' : 'failed'}}];"
